
# ==========================================
# PYTHON VIRTUAL ENVIRONMENTS
# ==========================================
.venv/
venv/
env/
ENV/
.conda/

# Isolated OCR environment
ocr_worker/.venv/

# ==========================================
# PYTHON CACHE AND COMPILED FILES
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==========================================
# ENVIRONMENT VARIABLES AND SECRETS
# ==========================================
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials.json

# ==========================================
# DATASETS AND DOCUMENT FILES
# ==========================================
data/
datasets/
uploads/
temp/
tmp/

# Ignore raw and processed document collections
*.pdf
*.docx
*.xlsx
*.pptx

# Exception: allow explicitly documented sample files
!docs/**/*.pdf

# ==========================================
# TRAINED MODELS AND CHECKPOINTS
# ==========================================
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.bin
*.h5
*.pkl
*.joblib

models/
checkpoints/
weights/

# ==========================================
